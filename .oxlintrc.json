{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/jsx-no-undef": "error",
    "no-undef": "error",
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": [
        "server/**",
        "api/**",
        "scripts/**",
        "vite.config.js"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
