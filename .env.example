# Copiá este archivo como .env.local y completalo con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Va la clave pública ("publishable"), nunca la secreta.
# En Vercel se cargan las mismas dos variables en Settings → Environment Variables.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
