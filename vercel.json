{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.loscardalesfutbol.com" }],
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "/api?__ruta=:ruta*" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [{ "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }]
}
